# APP CONFIG (DO NOT REMOVE!)
APP_NAME=
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=

# Vondo multi-restaurant tenant resolution. Keep header resolution disabled in production.
VONDO_BASE_DOMAIN=localhost
VONDO_DEFAULT_RESTAURANT=default
VONDO_ALLOW_TENANT_HEADER=false
VONDO_ACCESS_TOKEN_MINUTES=60
VONDO_REFRESH_TOKEN_DAYS=30
VONDO_PLATFORM_ACCESS_TOKEN_MINUTES=15
VONDO_PLATFORM_REFRESH_TOKEN_DAYS=1
VONDO_MEDIA_DRIVER=local
VONDO_MEDIA_DISK=vondo_media
VONDO_OWNER_PORTAL_URL=http://localhost:8081/vondo-admin
VONDO_BUILD_DISK=local
VONDO_BUILD_ARTIFACT_RETENTION_DAYS=30
VONDO_STOREFRONT_URL=http://localhost:3000
VONDO_BUILD_COMPILER_URL=
VONDO_BUILD_COMPILER_SECRET_REF=secret://vondo-build-compiler-hmac
VONDO_BUILD_CALLBACK_URL=
VONDO_BUILD_COMPILER_TIMEOUT_SECONDS=30
VONDO_BUILD_CALLBACK_TOLERANCE_SECONDS=300
VONDO_SECRET_DIRECTORY=/run/secrets
VONDO_SECRET_PROVIDER_URL=
VONDO_SECRET_PROVIDER_TOKEN_FILE=/run/secrets/vondo-secret-provider-token
VONDO_TLS_PROVIDER_URL=
VONDO_TLS_SECRET_REF=secret://vondo-tls-provider-hmac
VONDO_PUSH_PROVIDER_URL=
VONDO_PUSH_SECRET_REF=secret://vondo-push-provider-hmac
VONDO_PUSH_TIMEOUT_SECONDS=15
VONDO_API_HEALTH_URL=http://localhost:8081/api/v1/health/live
VONDO_STOREFRONT_HEALTH_URL=http://localhost:3000/health
VONDO_QUEUE_HEARTBEAT_SECONDS=300
APP_HTTP_PORT=8081
STOREFRONT_HTTP_PORT=3000
DB_FORWARD_PORT=3307
MYSQL_ROOT_PASSWORD=

IGNITER_CARTE_KEY=
IGNITER_LOCATION_MODE=multiple

# DATABASE CONFIG (DO NOT REMOVE!)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_STORE=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=null
MAIL_PORT=null
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@tastyigniter.tld
MAIL_FROM_NAME="${APP_NAME}"
